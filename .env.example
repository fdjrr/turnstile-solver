API_HOST=0.0.0.0
API_PORT=8000

# Multi-worker: one Camoufox browser process per worker
WORKER_COUNT=2
# Max in-flight solves (usually == WORKER_COUNT)
MAX_CONCURRENT=2

SOLVE_TIMEOUT_SECONDS=60
NAVIGATION_TIMEOUT_MS=30000
TASK_TTL_SECONDS=600

# Restart browser after N solves (prevents content-process RAM buildup; 0 = disable)
MAX_SOLVES_PER_BROWSER=100

# false = headed | true = headless | virtual = Xvfb
HEADLESS=true

# Camoufox fingerprint OS: windows | macos | linux
BROWSER_OS=windows

# Optional proxy list (one per line). Used when request omits "proxy".
PROXY_FILE=proxies.txt
